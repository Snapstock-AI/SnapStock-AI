# Database (Docker)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# pgAdmin (Docker)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Backend (local)
PORT=
DATABASE_URL=

# Optional: require Authorization: Bearer <token> on GET /metrics (Prometheus scrapes)
METRICS_TOKEN=

# JWT Authentication
JWT_SECRET=

# Frontend (local)
VITE_API_URL=
CLIENT_URL=
# LAN-reachable backend URL used by verify-email/reset-password email links
# (server/src/shared/utils/authPages.ts). Match mobile/.env's EXPO_PUBLIC_API_URL.
SERVER_PUBLIC_URL=

# Google OAuth (Continue with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Event-driven scan analysis (S3 + SQS). Leave S3_UPLOAD_BUCKET or a queue URL empty to disable
# it; the web client then uses the synchronous /detection/analyze endpoint.
# Local development uses LocalStack from docker-compose (dummy credentials are fine):
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_UPLOAD_BUCKET=snapstock-uploads
SQS_ANALYSIS_JOB_QUEUE_URL=http://localhost:4566/000000000000/snapstock-analysis-jobs
SQS_ANALYSIS_RESULT_QUEUE_URL=http://localhost:4566/000000000000/snapstock-analysis-results
# Optional: endpoint the browser uses for presigned uploads (defaults to AWS_ENDPOINT_URL)
S3_PUBLIC_ENDPOINT_URL=
