# Copy to monitoring/.env and fill in. Never commit .env or the PEM.

# SSH tunnel (PEM at repo root by default)
SSH_HOST=15.252.170.236
SSH_USER=ubuntu
SSH_PEM=../snapstock-k3s-key.pem
LOCAL_NODE_PORT=9100
REMOTE_NODE_PORT=9100

# Grafana login (local UI on http://localhost:3001)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Optional CloudWatch datasource (IAM user with cloudwatch:GetMetricData, etc.)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Same value as server METRICS_TOKEN when you enable scrape auth (also put in prometheus/metrics_token)
# METRICS_TOKEN=
