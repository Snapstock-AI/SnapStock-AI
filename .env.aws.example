# Real AWS S3/SQS configuration
# Create an AWS CLI profile with: aws configure --profile snapstock
AWS_PROFILE=snapstock
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=

# Use a globally unique bucket name created in ap-south-1.
S3_UPLOAD_BUCKET=snapstock-uploads-yourname-2026
AWS_TARGET_BUCKET=snapstock-uploads-yourname-2026
S3_PRESIGN_EXPIRY_SECONDS=900

# Set these after creating the real AWS queues.
SQS_ANALYSIS_JOB_QUEUE_URL=
SQS_ANALYSIS_RESULT_QUEUE_URL=

SCAN_TIMEOUT_MINUTES=15