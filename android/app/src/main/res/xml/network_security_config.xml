<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Production host only; no cleartext. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">snapstock.rashmika.dev</domain>
        <domain includeSubdomains="true">rashmika.dev</domain>
    </domain-config>
</network-security-config>
