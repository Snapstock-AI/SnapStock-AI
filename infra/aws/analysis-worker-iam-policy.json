{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadUploadedImages",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_UPLOAD_BUCKET/*"
    },
    {
      "Sid": "ConsumeAnalysisJobs",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:ap-south-1:REPLACE_WITH_ACCOUNT_ID:snapstock-analysis-jobs"
    },
    {
      "Sid": "PublishAnalysisResults",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage"],
      "Resource": "arn:aws:sqs:ap-south-1:REPLACE_WITH_ACCOUNT_ID:snapstock-analysis-results"
    }
  ]
}
