# Copy to terraform.tfvars (git-ignored). Never commit real values.

# Must be a snapstock-client image built AFTER the nginx proxy change (see README).
frontend_image_tag = "dev-<sha>"

jwt_secret       = "change-me-long-random"
google_client_id = ""

smtp_host = ""
smtp_port = "587"
smtp_user = ""
smtp_pass = ""

# After the first apply, set this to the ALB URL printed as `app_url`, then re-apply.
client_url = "http://localhost"

# Later, when you own a domain + ACM certificate in ap-south-1:
# certificate_arn = "arn:aws:acm:ap-south-1:<acct>:certificate/<id>"
